# =============================================================================
# 🧩 ORCHESTRATOR APPLY - IMAGE BUILD AND PREBUILD
# =============================================================================
# The image side of resource registration: which Dockerfile and target Tilt
# builds, the docker_build registration itself, the deferStart `<name>-image`
# prebuild local_resource, its dependency subset, and the compose invocation
# the wake gateway needs to start a deferred container directly.
# =============================================================================

# === INLINED CONSTANTS for pure extension loading ===
OUTPUT = struct(AUTOGENERATED_FOLDER = ".autogenerated")
# === END INLINED CONSTANTS ===

load('../../../../../discovery/native_windows.star', 'POWERSHELL')
load('../../common/windows_scripts.star', 'prebuild_image_script', 'reuse_prebuilt_image_script', 'image_retry_script')
load('../../common/utils_env.star', 'project_env_file')
load('../../../platform/docker/index.star', 'Docker')
load('./builders/typescript.star', 'TypescriptBuilders')
load('../../../platform/docker/constants.star', 'PlatformDockerConstants')
load('../../../platform/docker/networking/traefik_static_routes.star', 'normalize_abs_path')


def _app_image_name(resource_name, res_name):
    """The image ref docker_build builds and the app compose service declares (project-scoped; see constants.star)."""
    return PlatformDockerConstants.app_image_name(resource_name, res_name)


def wake_compose_invocation(project_root, resource_path, res_name, resource_name):
    """Compose files, env file and image for the wake gateway's direct start.

    The same files/--env-file the `-run-only` resource passes, as absolute
    normalized paths: the gateway mounts the project at the same normalized
    root (traefik_standalone.star), so these resolve identically there.
    Returns None without a project root (paths would be relative to Tilt's cwd).
    """
    if not project_root:
        return None
    root = normalize_abs_path(project_root)
    compose_dir = root + '/' + resource_path + '/' + OUTPUT.AUTOGENERATED_FOLDER
    files = [compose_dir + '/docker-compose.app.autogenerated.yml']
    port_override = compose_dir + '/docker-compose.port-override.yml'
    if os.path.exists(port_override):
        files.append(port_override)
    # The gateway mounts the project at its normalized absolute path, so the env file has to be
    # named the same way: project_env_file(root) is the project .env by default and the file
    # `flisk up --env-file` selected (an absolute path inside the project) otherwise.
    env_file = project_env_file(root)
    return {
        'compose_files': files,
        'env_file': env_file if os.path.exists(env_file) else '',
        'image': _app_image_name(resource_name, res_name),
    }


def _uses_generated_dockerfile(config):
    """True when Tilt builds the Dockerfile Flisk generates, not one the user wrote (`dockerfile` outside `.autogenerated`)."""
    rel_dockerfile = config.get('dockerfile', '')
    return not rel_dockerfile or OUTPUT.AUTOGENERATED_FOLDER in rel_dockerfile.split('/')


def uses_own_dockerfile(config):
    """True when the resource builds from a Dockerfile the user wrote: config generation then writes only the env file and
    YAML mirror, so live-update syncs must not reference `.autogenerated` files that are never generated."""
    return bool(config.get('dockerfile', '')) and not _uses_generated_dockerfile(config)


def image_target(config):
    """The Dockerfile target Tilt builds and the deferStart prebuild must match: `development` wherever a stage reloads on a sync."""
    manifest = config.get('manifest', {})
    # Next.js runs `next dev` in the development image, so a saved file hot-reloads through the synced sources.
    if Docker.is_next_frontend(manifest):
        return 'development'
    # A Bun backend's generated development stage runs its watching `dev` script over the synced sources; production would run the
    # stale dist (#3395). A Dockerfile the user wrote may have no such stage (or only `production`), so it keeps building `production`.
    if _uses_generated_dockerfile(config) and Docker.bun_live_reload(manifest, config['res_path']):
        return 'development'
    return 'development' if Docker.go_live_reload(manifest) else 'production'


# Runs instead of a second image build once `<name>-image` built the image. `<prebuild Dockerfile>.built` is stamped when
# that build started; while no watched file is newer, the image is current and is only given the tag Tilt expects. A
# cached rebuild of it took 1 to 3 s per service on every start (#4237). Anything newer, or no stamp, builds as before.
_REUSE_PREBUILT_IMAGE_SCRIPT = (
    'df="$1"; pre="$2"; ign="$3"; target="$4"; img="$5"; ctx="$6"; shift 6; '
    + 'if [ -f "$pre.built" ]'
    + ' && [ -z "$(find "$@" \\( -name node_modules -o -name .git \\) -prune -o -type f ! -name "*.prebuild*" -newer "$pre.built" -print 2>/dev/null | head -n 1)" ]'
    + ' && docker tag "$img" "$EXPECTED_REF" 2>/dev/null; then'
    + ' echo "[flisk] nothing changed since $img was built, using it as is"; exit 0; fi; '
    + 'cp "$df" "$pre" && printf "%s" "$ign" > "$pre.dockerignore"'
    + ' && docker build --network host --target "$target" -f "$pre" -t "$EXPECTED_REF" "$ctx"'
)


def register_docker_build(config, live_update_rules, reuse_prebuilt=False):
    """Register docker_build with live_update for hot-reload support.

    `reuse_prebuilt`: the resource has a `<name>-image` step, so its first build uses that image instead of building it again.
    """
    prebuilt = None
    if reuse_prebuilt:
        args = _prebuild_args(config)
        env = dict(_prebuild_env(args))
        # A PowerShell -Command gets no trailing argv, so the watched paths the POSIX command reads
        # from "$@" travel in FLISK_WATCH_PATHS. The prefix keeps the tag the `-image` step built in
        # FLISK_SOURCE_TAG before Tilt's expected ref takes FLISK_TAG over (reuse_prebuilt_image_script).
        env['FLISK_WATCH_PATHS'] = encode_json(TypescriptBuilders.watched_build_paths(args[0], args[5]))
        prebuilt = {
            'command': ['sh', '-c', _REUSE_PREBUILT_IMAGE_SCRIPT, 'sh'] + args,
            'command_bat': POWERSHELL + ['$env:FLISK_SOURCE_TAG = $env:FLISK_TAG; $env:FLISK_TAG = $env:EXPECTED_REF; ' + reuse_prebuilt_image_script()],
            'env': env,
        }
    TypescriptBuilders.build_typescript_service(
        _app_image_name(config['resource_name'], config['res_name']),
        config.get('project_root', '') or '.',
        _resolve_dockerfile(config),
        live_update_rules,
        config['res_deps'],
        target = image_target(config),
        prebuilt = prebuilt,
    )


def _prebuild_args(config):
    """[Dockerfile, its `.prebuild` copy, allowlist .dockerignore content, target, image tag, build context] of a plain `docker build`."""
    project_root = config.get('project_root', '')
    dockerfile = _resolve_dockerfile(config)
    return [
        dockerfile,
        dockerfile + '.prebuild',
        TypescriptBuilders.prebuild_dockerignore(dockerfile, project_root, config['res_path']),
        # The same target register_docker_build picks: a service that reloads (Go with `dev.liveReload`, Bun with a watching `dev` script) runs
        # the development image, so prebuilding `production` under the same tag would start the compiled build with no reload.
        image_target(config),
        _app_image_name(config['resource_name'], config['res_name']),
        project_root or '.',
    ]


def _prebuild_env(args):
    return {
        'FLISK_DOCKERFILE': args[0],
        'FLISK_PREBUILD': args[1],
        'FLISK_IGNORE': args[2],
        'FLISK_TARGET': args[3],
        'FLISK_TAG': args[4],
        'FLISK_BUILD_CONTEXT': args[5],
    }


# The first attempt only. A failure is recorded and reported by a non-zero return from the
# <stack>-image-retry resource below, which runs once every parallel first attempt is done and
# Tilt's allow_parallel=False keeps serial. Retrying inline here made two identical backends
# retry at the same time against the same BuildKit cache (flisk#4226).
# The stamp the last passed attempt left (`$pre.built`, set before the build read the files) makes
# the repeat `docker build` of a restart with nothing changed optional: the image is still tagged
# and no watched file is newer, so there is nothing to rebuild. The service's own build still runs
# after this one and only re-tags the same image, so per start an image is built at most once —
# a cached rebuild still walked ~40-50 steps and sent the whole context per service (#4237).
_IMAGE_BUILD_SCRIPT = (
    'df="$1"; pre="$2"; ign="$3"; target="$4"; img="$5"; ctx="$6"; shift 6; '
    + 'if [ "$#" -gt 0 ] && [ -f "$pre.built" ]'
    + ' && docker image inspect "$img" >/dev/null 2>&1'
    + ' && [ -z "$(find "$@" \\( -name node_modules -o -name .git \\) -prune -o -type f ! -name "*.prebuild*" -newer "$pre.built" -print 2>/dev/null | head -n 1)" ]; then'
    + ' echo "[flisk] nothing changed since $img was built, using it as is"; exit 0; fi; '
    + 'rm -f "$pre.failed" "$pre.built"; '
    + 'cp "$df" "$pre" && printf "%s" "$ign" > "$pre.dockerignore" && touch "$pre.started"'
    + ' && docker build --network host --target "$target" -f "$pre" -t "$img" "$ctx"'
    + ' && { mv "$pre.started" "$pre.built"; exit 0; }; '
    + 'echo "[flisk] image build failed ($img); queued for one serial retry after the parallel batch"; '
    + ': > "$pre.failed"; rm -f "$pre.started"; exit 0'
)


# argv comes in groups of four: [prebuild copy, target, image tag, build context] per image.
# Only images whose first attempt failed have a marker, and the loop retries them one at a time.
_IMAGE_RETRY_SCRIPT = (
    'failed=0; '
    + 'while [ "$#" -gt 0 ]; do '
    + '  pre="$1"; target="$2"; img="$3"; ctx="$4"; shift 4; '
    + '  [ -f "$pre.failed" ] || continue; '
    + '  echo "[flisk] retrying $img once, serially (transient BuildKit cache error)"; '
    + '  if docker build --network host --target "$target" -f "$pre" -t "$img" "$ctx"; then '
    + '    rm -f "$pre.failed" "$pre.started"; touch "$pre.built"; '
    + '  else '
    + '    echo "[flisk] $img failed again after the serial retry"; failed=1; '
    + '  fi; '
    + 'done; '
    + 'exit "$failed"'
)


def will_prebuild_image(config):
    """True when the resource gets a <name>-image build step (mirrors _register_single_resource)."""
    if config.get('app_type') in ['library', 'sdk', 'bring-your-own'] or not config.get('syncs'):
        return False
    if config.get('_defers_start', False):
        return True
    return needs_image_prebuild(config['res_deps'])


def register_deferred_image_prebuild(config, auto_init_apps, deps=None):
    """Build a deferStart resource's image during `flisk up` without creating its container.

    `auto_init=False` on the dc_resource skips its docker_build too (confirmed
    live on flisk-erp-system, task 7.2), so a fresh project's first request would
    find no image and the wake gateway would fall back to `tilt trigger`, which
    queues behind every other build. This local_resource builds the same image
    (same Dockerfile and target as docker_build: `production`, or `development` for Go with `dev.liveReload` and Bun with a watching `dev` script; host network, and an allowlist
    .dockerignore equivalent to docker_build's only=/ignore=) under the tag the
    compose service declares, so the gateway can start it directly. On a start
    where the `.built` stamp is still fresh and the image is still present it
    skips the cached rebuild — the image is already what a build would produce.
    """
    # BuildKit reads `<dockerfile>.dockerignore` for `-f <dockerfile>`; the
    # original Dockerfile already has a (denylist) one, hence the copy.
    # `.started` is stamped before the build reads the files and becomes `.built` only when the build passed, so a file
    # edited while it ran is newer than the stamp and _REUSE_PREBUILT_IMAGE_SCRIPT builds again.
    # The watched paths go after the six `_prebuild_args` fields: a restart whose stamp is fresh and whose
    # image is still there skips the cached `docker build` entirely (#4237). cmd_bat reads them from
    # FLISK_WATCH_PATHS instead — a PowerShell -Command gets no trailing argv.
    args = _prebuild_args(config)
    watch = TypescriptBuilders.watched_build_paths(args[0], args[5])
    cmd = ["sh", "-c", _IMAGE_BUILD_SCRIPT, "sh"] + args + watch
    env = dict(_prebuild_env(args))
    env['FLISK_WATCH_PATHS'] = encode_json(watch)
    local_resource(
        name=config['res_name'] + '-image',
        cmd=cmd,
        cmd_bat=POWERSHELL + [prebuild_image_script()],
        env=env,
        labels=config['labels'],
        resource_deps=config['res_deps'] if deps == None else deps,
        auto_init=auto_init_apps,
        allow_parallel=deps != None,
    )


def register_image_retry_gate(stack_name, resource_configs, auto_init_apps, ctx):
    """One serial retry pass for a stack's image builds, after their parallel first attempts.

    The `<name>-image` resources no longer retry inline: a transient BuildKit cache error is
    recorded as a marker and the first attempt exits 0, so this gate still runs (a Tilt resource
    whose dependency failed is skipped). It depends on every image build in the stack and has
    allow_parallel=False, so it starts after the whole parallel batch and retries failures one
    at a time. A permanent failure leaves the gate red, which keeps the services behind it down.
    """
    name = stack_name + '-image-retry'
    # Tilt freezes Starlark globals, so the guard lives on the ctx dict the Tiltfile owns.
    registered = ctx.setdefault('_image_retry_gates', {})
    if name in registered:
        return
    registered[name] = True

    builds = [config for config in resource_configs if will_prebuild_image(config)]
    if not builds:
        return
    retry_args = []
    for config in builds:
        args = _prebuild_args(config)
        # _prebuild_args: [Dockerfile, prebuild copy, ignore, target, tag, context].
        retry_args = retry_args + [args[1], args[3], args[4], args[5]]

    local_resource(
        name=name,
        cmd=['sh', '-c', _IMAGE_RETRY_SCRIPT, 'sh'] + retry_args,
        cmd_bat=POWERSHELL + [image_retry_script()],
        env={'FLISK_IMAGE_RETRY_ARGS': encode_json(retry_args)},
        # A stack name can be 63 bytes; prefixing it with `app.` would exceed Tilt's label limit.
        labels=['image-retry'],
        resource_deps=[config['res_name'] + '-image' for config in builds],
        auto_init=auto_init_apps,
        allow_parallel=False,
    )


# Exported for tests (a Starlark module cannot load an underscore name).
IMAGE_BUILD_SCRIPT = _IMAGE_BUILD_SCRIPT
IMAGE_RETRY_SCRIPT = _IMAGE_RETRY_SCRIPT


def _image_build_input(dep):
    """True for a dep the image build itself needs: the generated Dockerfile, the package registry or the golden images."""
    return dep.endswith('-config-gen') or dep == 'golden-layers-build' or dep == PlatformDockerConstants.VERDACCIO_RESOURCE_NAME


def image_prebuild_deps(res_deps):
    """The deps of a resource's `<name>-image` build: what the build needs, then Postgres when the service needs it.

    The rest (the migrator, other services) only matter once the container starts. Postgres is kept as an ordering dep, not
    an input: Tilt starts every docker_compose resource only after the local resources that are ready at the same time, and
    the image builds are local resources that hold every update slot (max_parallel_updates) for minutes. Postgres, needing
    no build and starting in about 5 s, waited 3 min 40 s on a cold demo start, and the databases, the migrator and every
    API waited behind it (#4127). Waiting for it costs each image build those few seconds.
    """
    deps = [dep for dep in res_deps if _image_build_input(dep)]
    if 'postgres' in res_deps:
        deps.append('postgres')
    return deps


def needs_image_prebuild(res_deps):
    """True when the resource waits for something its image build does not need (see image_prebuild_deps).

    Tilt holds a dc_resource's docker_build until every resource_dep is ready, so without a separate build step a service
    that depends on another is built only after that one is healthy, and a chain of dependsOn builds one image at a time.
    """
    return len([dep for dep in res_deps if _image_build_input(dep)]) < len(res_deps)


def _resolve_dockerfile(config):
    """Absolute (when project_root is set) path of a resource's Dockerfile."""
    project_root = config.get('project_root', '')
    # Use custom dockerfile from config if specified, otherwise use autogenerated default
    # The res_path is relative to project_root (e.g., 'services/product/...')
    # The dockerfile config is relative to res_path (e.g., '.autogenerated/Dockerfile...')
    rel_dockerfile = config.get('dockerfile', '')
    if rel_dockerfile:
        if rel_dockerfile.startswith('/'):
            dockerfile = config['res_path'] + rel_dockerfile
        else:
            dockerfile = config['res_path'] + '/' + rel_dockerfile
    else:
        dockerfile = config['res_path'] + '/' + OUTPUT.AUTOGENERATED_FOLDER + '/Dockerfile.app.autogenerated'
    # Prepend project_root to make absolute path from the Tilt working directory
    if project_root:
        if dockerfile.startswith('/'):
            dockerfile = project_root + dockerfile
        else:
            dockerfile = project_root + '/' + dockerfile
    return dockerfile
