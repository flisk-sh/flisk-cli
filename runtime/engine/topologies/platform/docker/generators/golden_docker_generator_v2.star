# === INLINED CONSTANTS for pure extension loading ===
OUTPUT = struct(AUTOGENERATED_FOLDER = ".autogenerated")
# === END INLINED CONSTANTS ===


BUN_BASE = "oven/bun:1.3.11-alpine"
ALPINE_BASE = "alpine:3.22"


load('../../../tilt/common/utils.star', 'Utils')
load('../../../tilt/manifest/constants.star', 'GENERATED_CONFIG_FILENAMES')
load('../../../../../discovery/native_windows.star', 'dir_exists')

# Load layer generators from dedicated modules
load('../layers/l1_base_layers.star', 'L1_generate_os_base', 'L1_generate_runtime_env')
load('../layers/l2_dependency_layers.star', 'L2_generate_dependency_manifest')
load('../layers/l3_builder_layers.star',
    'L3_generate_backend_compiler',
    'L3_generate_frontend_builder',
    'L3_generate_production_purger',
    'backend_golden_image',
)
load('../layers/prisma/prisma_runtime.star', 'L4_generate_migrator_runtime')
load('../layers/l4_runtime_layers.star',
    'L4_generate_backend_runtime',
    'L4_generate_frontend_runtime',
)


def _migrator_service_path(res_path):
    """The service dir a <name>-migrator resource migrates, or res_path itself when there is none.

    The CLI scaffolds a <service>-migrator service next to the service it migrates; the dedicated
    <service>-db-migrator Dockerfile already points at the service's path. Resolving the sibling
    here makes the migrator's install stage and dependency COPYs identical to the service's, so
    BuildKit shares those layers instead of installing the same node_modules a second time
    (flisk#4070). A migrator whose sibling does not exist keeps its own path and still builds.
    """
    for suffix in ('-db-migrator', '-migrator'):
        if res_path.endswith(suffix):
            sibling = res_path[:-len(suffix)]
            if dir_exists(sibling):
                return sibling
            break
    return res_path


def L4_generate_orchestrator(res_path, res_type = 'backend', resource_name = 'service', use_nginx = False, port = 3000, target_path = '/app/dist', build_cmd = 'bun run build', cmd = 'bun run start', use_infisical = False, use_shared_libs = True, use_prisma = True, use_golden = True, manifest = None):
    parts = []
    migrator_name_match = (
        resource_name == 'migrator'
        or resource_name.endswith('-migrator')
        or resource_name.endswith('-db-migrator')
    )
    is_migrator = res_type == 'migrator' or (res_type == 'backend' and migrator_name_match)
    # res_type 'migrator' is already called with the backend's path (Dockerfile.migrator); a
    # <name>-migrator service resolves its sibling so both cases emit the service's own stages.
    migrator_res_path = _migrator_service_path(res_path) if res_type == 'backend' and migrator_name_match else res_path
    prisma_config_exists = use_prisma and read_file(res_path + '/' + OUTPUT.AUTOGENERATED_FOLDER + '/' + GENERATED_CONFIG_FILENAMES['prisma'], default='') != ''
    parts.append(L1_generate_os_base(use_golden=use_golden))
    parts.append(L1_generate_runtime_env(None))
    parts.append(L2_generate_dependency_manifest(res_path, use_golden=use_golden))

    if is_migrator:
        # A migrator's dependencies are the service's: emit the same production-install stage the
        # backend image builds (same instructions, same inputs), so the install runs once and both
        # images share the layers. The old l3_migration_build stage installed the same packages a
        # second time for every migrator (flisk#4070).
        # Called exactly as the backend calls it below, so the emitted stage is byte-identical.
        parts.append(L3_generate_production_purger(migrator_res_path, pin_prisma_cli=use_prisma))
    elif res_type == 'frontend':
        parts.append(L3_generate_frontend_builder(res_path, build_cmd, use_infisical, use_shared_libs, use_golden=use_golden))
    else:
        parts.append(L3_generate_backend_compiler(
            res_path,
            build_cmd,
            use_prisma,
            use_shared_libs,
            use_infisical,
            use_golden=use_golden,
            has_prisma_config=prisma_config_exists,
            base_image=backend_golden_image(res_path, use_golden),
        ))
        # Backend runtime needs production-purged deps. The pinned Prisma CLI comes from that same
        # install (pin_prisma_cli), not from a migration stage with installs of its own (flisk#3710).
        parts.append(L3_generate_production_purger(res_path, pin_prisma_cli=use_prisma))

    if res_type == 'frontend':
        parts.append(L4_generate_frontend_runtime(res_path, target_path, use_nginx, use_golden=use_golden, port=port))
    elif is_migrator:
        parts.append(L4_generate_migrator_runtime(migrator_res_path, resource_name, use_golden=use_golden))
    else:
        parts.append(
            L4_generate_backend_runtime(
                res_path,
                port,
                cmd,
                use_infisical,
                resource_name,
                use_golden=use_golden,
                use_prisma=use_prisma,
                has_prisma_config=prisma_config_exists,
                manifest=manifest,
            ),
        )
    dockerfile = "\n\n".join(parts)
    footer = Utils.get_template_header("dockerfile", "golden_docker_generator_v2.L4_generate_orchestrator", resource_name, "Use docker_build(dockerfile_contents=...) in Tiltfile")
    # No `# syntax=docker/dockerfile:1` line: it makes BuildKit fetch the frontend from Docker Hub and then ask Docker Hub
    # about every local golden base image, about 1.5 s per cached build (flisk#4237). The built-in frontend of Docker 25
    # (the oldest `flisk doctor` accepts) reads the migrator's heredocs (RUN cat > ... << 'EOF').
    return dockerfile + "\n\n" + footer
