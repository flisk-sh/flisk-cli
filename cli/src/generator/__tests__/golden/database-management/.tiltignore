# =============================================================================
# 🚫 Flisk CLI - TILT IGNORE FILE
# =============================================================================
# SYSTEM-GENERATED BY Flisk CLI - DO NOT EDIT
# Source: .flisk/project.json
# Regenerate with: flisk config regenerate
# =============================================================================
#
# This file tells Tilt which directories to ignore during file watching.
# Prevents fsnotify buffer overflow and reduces unnecessary rebuilds.
#
# =============================================================================

# Dependency directories
**/node_modules

# Build outputs (anchored so a source folder or resource named dist/build/out stays watched)
/dist
services/*/*/dist
services/*/*/build
services/*/*/out
**/.next
**/.output

# Version control
**/.git

# Generated files (root-only caches; per-service output is matched under services/*/*/)
**/.prisma
**/.turbo
/coverage
services/*/*/coverage
/tmp
/temp

# IDE files
**/.idea
**/.vscode
**/*.swp
**/*.swo

# OS files
**/.DS_Store
**/Thumbs.db

# Docker volumes and data
**/postgres-data
**/redis-data
**/verdaccio-storage
**/verdaccio-conf
**/verdaccio-plugins

# Flisk generated outputs (avoid watching generated files)
**/.flisk/.flisk-out
**/.autogenerated/**
**/.autogenerated/*.autogenerated
**/.autogenerated/*.autogenerated.json
**/.autogenerated/*.autogenerated.yml
**/.autogenerated/*.autogenerated.toml

# Logs (root-only; a source folder named logs is still watched)
**/*.log
/logs

# Test outputs
**/test-results
**/playwright-report
**/.nyc_output

# Cache directories
**/.cache
**/.npm
**/.bun
**/bun.lockb
/docker
